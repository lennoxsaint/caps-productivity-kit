{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/caps/schemas/routing-receipt.schema.json",
  "title": "CAPS redacted runtime routing receipt",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_id",
    "started_at",
    "finished_at",
    "lifecycle_state",
    "binding_state",
    "bound_at",
    "worker_kind",
    "worker_ref_hash",
    "parent_receipt_id",
    "delegation_depth",
    "task_class",
    "requested_model",
    "requested_thinking",
    "resolved_model",
    "resolved_thinking",
    "capability_snapshot_digest",
    "capability_verified",
    "routing_mode",
    "route_reason",
    "quality_gate_id",
    "task_snapshot_complete",
    "profile_version",
    "observability_state",
    "observability_failure_code",
    "learning_eligibility",
    "elapsed_seconds",
    "quality_passed",
    "gate_result",
    "delegation_quality",
    "outcome",
    "severe_error",
    "retry_count",
    "rework_seconds",
    "proof_refs",
    "failure_code",
    "escalation_reason",
    "input_tokens",
    "output_tokens",
    "estimated_cost_usd",
    "evidence_kind"
  ],
  "properties": {
    "schema_version": {"const": "1.2"},
    "receipt_id": {"type": "string", "format": "uuid"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": ["string", "null"], "format": "date-time"},
    "lifecycle_state": {"type": "string", "enum": ["pending", "completed", "abandoned"]},
    "binding_state": {"type": "string", "enum": ["unbound", "bound"]},
    "bound_at": {"type": ["string", "null"], "format": "date-time"},
    "worker_kind": {"type": "string", "enum": ["subagent", "durable_thread"]},
    "worker_ref_hash": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
    "parent_receipt_id": {"type": ["string", "null"], "format": "uuid"},
    "delegation_depth": {"type": "integer", "minimum": 0, "maximum": 2},
    "task_class": {"type": "string", "enum": ["coding", "research_strategy", "computer_use", "content_polish", "transformation", "proof_review"]},
    "requested_model": {"type": "string", "minLength": 1},
    "requested_thinking": {"type": "string", "minLength": 1},
    "resolved_model": {"type": "string", "minLength": 1},
    "resolved_thinking": {"type": "string", "minLength": 1},
    "capability_snapshot_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "capability_verified": {"type": "boolean"},
    "routing_mode": {"type": "string", "enum": ["direct", "probe_then_escalate"]},
    "route_reason": {"type": "string", "enum": ["default", "policy", "canary", "override", "bakeoff"]},
    "quality_gate_id": {"type": "string", "minLength": 1, "maxLength": 80},
    "task_snapshot_complete": {"type": "boolean"},
    "experiment_id": {"type": ["string", "null"]},
    "profile_version": {"type": "string", "minLength": 1},
    "host": {"type": "string"},
    "observability_state": {"type": "string", "enum": ["complete", "degraded"]},
    "observability_failure_code": {"type": ["string", "null"], "maxLength": 80},
    "learning_eligibility": {"type": "string", "enum": ["eligible", "ineligible"]},
    "elapsed_seconds": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "quality_passed": {"type": ["boolean", "null"]},
    "gate_result": {"type": ["string", "null"], "enum": ["pass", "fail", "abandoned", null]},
    "delegation_quality": {"type": ["string", "null"], "enum": ["complete", "partial", "failed", null]},
    "outcome": {"type": ["string", "null"], "enum": ["pass", "fail", "abandoned", null]},
    "severe_error": {"type": "boolean"},
    "retry_count": {"type": "integer", "minimum": 0},
    "rework_seconds": {"type": "number", "minimum": 0},
    "proof_refs": {"type": "array", "items": {"type": "string"}},
    "failure_code": {"type": ["string", "null"], "maxLength": 80},
    "escalation_reason": {"type": ["string", "null"], "maxLength": 120},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "estimated_cost_usd": {"type": ["number", "null"], "minimum": 0},
    "evidence_kind": {"const": "runtime_observation"}
  },
  "allOf": [
    {
      "if": {"properties": {"binding_state": {"const": "unbound"}}},
      "then": {"properties": {"bound_at": {"const": null}, "worker_ref_hash": {"const": null}}},
      "else": {
        "properties": {
          "bound_at": {"type": "string", "format": "date-time"},
          "worker_ref_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
        }
      }
    },
    {
      "if": {"properties": {"lifecycle_state": {"const": "pending"}}},
      "then": {
        "properties": {
          "finished_at": {"const": null},
          "elapsed_seconds": {"const": null},
          "quality_passed": {"const": null},
          "gate_result": {"const": null},
          "delegation_quality": {"const": null},
          "outcome": {"const": null},
          "learning_eligibility": {"const": "ineligible"}
        }
      }
    },
    {
      "if": {"properties": {"lifecycle_state": {"const": "completed"}}},
      "then": {
        "properties": {
          "binding_state": {"const": "bound"},
          "finished_at": {"type": "string", "format": "date-time"},
          "elapsed_seconds": {"type": "number", "exclusiveMinimum": 0},
          "quality_passed": {"type": "boolean"},
          "gate_result": {"type": "string", "enum": ["pass", "fail"]},
          "delegation_quality": {"type": "string", "enum": ["complete", "partial", "failed"]},
          "outcome": {"type": "string", "enum": ["pass", "fail"]}
        }
      }
    },
    {
      "if": {"properties": {"lifecycle_state": {"const": "abandoned"}}},
      "then": {
        "properties": {
          "finished_at": {"type": "string", "format": "date-time"},
          "elapsed_seconds": {"type": "number", "exclusiveMinimum": 0},
          "quality_passed": {"const": false},
          "gate_result": {"const": "abandoned"},
          "delegation_quality": {"type": "string", "enum": ["complete", "partial", "failed"]},
          "outcome": {"const": "abandoned"},
          "learning_eligibility": {"const": "ineligible"}
        }
      }
    },
    {
      "if": {"properties": {"learning_eligibility": {"const": "eligible"}}},
      "then": {
        "properties": {
          "lifecycle_state": {"const": "completed"},
          "binding_state": {"const": "bound"},
          "capability_verified": {"const": true},
          "observability_state": {"const": "complete"},
          "task_snapshot_complete": {"const": true}
        }
      }
    }
  ],
  "additionalProperties": false
}
